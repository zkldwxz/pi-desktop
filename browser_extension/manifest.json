{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.2.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "125",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "debugger",
    "activeTab",
    "tabs",
    "tabGroups",
    "alarms"
  ],
  "action": {
    "default_title": "pi-desktop",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
